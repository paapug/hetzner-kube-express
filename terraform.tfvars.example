# Prefer SOPS (encrypted secrets in git):
#
#   brew install age sops
#   make sops-setup          # age key, cluster ed25519 SSH key, secrets.enc.json
#   make secrets-edit        # set hcloud_token, firewall CIDRs, etc.
#   make ssh-export          # write .age/cluster_ed25519 from SOPS for ssh(1)
#   make plan && make apply
#
# Plaintext fallback (gitignored):
#   cp terraform.tfvars.example terraform.tfvars   # not used — see secrets.example.json
#   export TF_VAR_hcloud_token=...
#   terraform apply
