# Cloudflare R2 credentials override.
#
# The DEFAULT auth path is the AWS shared credentials file: env.hcl declares
# `r2_aws_profile` (e.g. "r2-hetzner-k8s-playground") and you put the keys in
# ~/.aws/credentials under that profile name. That works for both `terragrunt`
# AND the helper scripts in cluster/_scripts/, no env vars needed:
#
#   # ~/.aws/credentials
#   [r2-hetzner-k8s-playground]
#   aws_access_key_id     = your-r2-access-key-id
#   aws_secret_access_key = your-r2-secret-access-key
#
# This .env file is for OVERRIDES — handy if you want to test against a
# different R2 token without touching ~/.aws/credentials, or work in a
# container where ~/.aws isn't mounted.
#
# Copy to one of (both gitignored; never commit the real .env):
#   <repo-root>/.env       (one set for the whole repo)
#   cluster/<env>/.env     (per-env override; wins over repo-root)
#
# Loading the file:
#   * The cluster/_scripts/* helpers auto-source it (no extra setup).
#   * `terragrunt` does NOT read .env on its own. Pick one:
#       - direnv:  echo 'dotenv .env' > cluster/dev/.envrc && direnv allow cluster/dev
#       - dotenvx: dotenvx run -f .env -- terragrunt run --all plan
#       - manual:  set -a; source .env; set +a
#
# Precedence (matches the AWS SDK's standard chain):
#   AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY  >  AWS_PROFILE  >  r2_aws_profile

AWS_ACCESS_KEY_ID=your-r2-access-key-id
AWS_SECRET_ACCESS_KEY=your-r2-secret-access-key
AWS_REGION=auto
